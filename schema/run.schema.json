{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sealstack.dev/schema/run.schema.json",
  "title": "Run",
  "type": "object",
  "required": [
    "id",
    "kind",
    "deck",
    "deckFingerprint",
    "model",
    "input",
    "outcome",
    "status",
    "startedAt",
    "finishedAt",
    "seal"
  ],
  "additionalProperties": true,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^run-[0-9a-f]{10}$"
    },
    "kind": {
      "const": "run"
    },
    "deck": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,79})-[0-9a-f]{6}$"
    },
    "deckFingerprint": {
      "type": "string",
      "anyOf": [
        {
          "const": ""
        },
        {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      ]
    },
    "model": {
      "type": "string"
    },
    "input": {
      "type": "string"
    },
    "outcome": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "pattern": "\\S"
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "finishedAt": {
      "type": "string",
      "anyOf": [
        {
          "const": ""
        },
        {
          "type": "string",
          "format": "date-time"
        }
      ]
    },
    "seal": {
      "type": "object",
      "required": [
        "fingerprint",
        "created",
        "version"
      ],
      "additionalProperties": false,
      "properties": {
        "fingerprint": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "created": {
          "type": "string",
          "format": "date-time"
        },
        "version": {
          "type": "integer",
          "const": 1
        }
      }
    }
  }
}
