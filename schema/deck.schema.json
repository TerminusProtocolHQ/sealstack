{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sealstack.dev/schema/deck.schema.json",
  "title": "Deck",
  "type": "object",
  "required": [
    "id",
    "kind",
    "title",
    "stacks",
    "seal"
  ],
  "additionalProperties": true,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,79})-[0-9a-f]{6}$"
    },
    "kind": {
      "const": "deck"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "summary": {
      "type": "string"
    },
    "stacks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9](?:[a-z0-9-]{0,79})-[0-9a-f]{6}$"
      }
    },
    "seal": {
      "type": "object",
      "required": [
        "fingerprint",
        "created",
        "version"
      ],
      "additionalProperties": false,
      "properties": {
        "fingerprint": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "created": {
          "type": "string",
          "format": "date-time"
        },
        "version": {
          "type": "integer",
          "const": 1
        }
      }
    }
  }
}
